# Cloudflare Pages headers
# ⚠️ קובץ זה פעיל רק אם האתר מתארח ב-Cloudflare Pages. האתר החי כיום ב-GitHub Pages,
#    ש*אינו* תומך בכותרות HTTP מותאמות — ולכן ה-CSP האמיתי מוגדר כתגית <meta> בתוך
#    index.html / register.html / management.html. הקובץ נשמר למקרה מעבר עתידי ל-Cloudflare
#    (ושם frame-ancestors שבכותרת יוסיף גם הגנת clickjacking). יש לשמור את שתי ההגדרות תואמות.
#
# Content-Security-Policy (CSP): רשת ביטחון נגד XSS. גם אם קוד זדוני יחדור לדף,
# ה-CSP חוסם ממנו לטעון סקריפטים ממקורות זרים ולשלוח נתונים החוצה (exfiltration).
# רשימת המקורות המותרים נבנתה במדויק לפי מה שהתוכנה באמת טוענת:
#   • script  : Firebase SDK (gstatic), Google Sign-In (apis.google), מפה (unpkg/Leaflet),
#               ייצוא PDF (jsdelivr — html2canvas/jspdf). 'unsafe-inline' נדרש כי כל
#               האפליקציה כתובה כסקריפט מוטבע (inline) בדף עצמו.
#   • connect : Firestore + Firebase Auth (*.googleapis.com), גשר Apps Script
#               (script.google.com + script.googleusercontent.com), גאוקוד (Nominatim).
#   • frame   : חלון/מסגרת ההתחברות של Firebase/Google.
#   • img     : לוגו כ-data URI, אריחי מפה של OpenStreetMap, אייקוני Leaflet.
# ⚠️ אם מוסיפים ספריית CDN חדשה / שירות חיצוני — יש להוסיף כאן את המקור, אחרת ייחסם.

# Baseline security headers for every response
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://www.google.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://unpkg.com https://*.tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://firebaseappcheck.googleapis.com https://script.google.com https://script.googleusercontent.com https://nominatim.openstreetmap.org https://www.google.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://apis.google.com https://www.google.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# The app HTML must always be revalidated so updates reach installed users immediately
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Service worker must always be revalidated so PWA updates reach users immediately
/sw.js
  Cache-Control: no-cache

# App manifest should revalidate too
/manifest.webmanifest
  Cache-Control: no-cache
